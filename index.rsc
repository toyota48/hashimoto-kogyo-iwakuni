13:["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"LocalBusiness\",\"name\":\"株式会社ハシモト工業\",\"legalName\":\"株式会社ハシモト工業\",\"description\":\"山口県岩国市の株式会社ハシモト工業のコーポレートサイト。鉄塔送電線工事、送電線設備の関連工事、対応エリア、会社概要、お問い合わせを掲載しています。\",\"url\":\"https://toyota48.github.io/hashimoto-kogyo-iwakuni/\",\"telephone\":\"0827-46-1201\",\"address\":{\"@type\":\"PostalAddress\",\"addressRegion\":\"山口県\",\"addressLocality\":\"山口県岩国市\",\"addressCountry\":\"JP\"},\"identifier\":\"山口県知事許可 第013833号\",\"areaServed\":\"岩国市を中心に、山口県東部および近隣地域のご相談に対応します。\",\"makesOffer\":[{\"@type\":\"Offer\",\"itemOffered\":{\"@type\":\"Service\",\"name\":\"鉄塔送電線工事\",\"description\":\"送電線鉄塔に関わる工事を中心に、電力インフラを支える現場作業に対応する想定です。高所作業を伴うため、安全確認とチーム連携を重視した施工内容として整理しています。\"}},{\"@type\":\"Offer\",\"itemOffered\":{\"@type\":\"Service\",\"name\":\"送電設備の関連工事\",\"description\":\"送電線工事に付帯する準備、現場環境の整備、資材・安全管理の補助などを紹介する想定です。対応可否や工事区分は正式確認が必要です。\"}}]}"}}]
